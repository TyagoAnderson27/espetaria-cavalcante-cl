{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "LEIA-ME.md",
      "banco.js",
      "espetaria-backup-*.json",
      "**/.*",
      "**/node_modules/**",
      "firebase-debug.log",
      ".firebase"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}